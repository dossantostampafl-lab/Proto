FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-live.txt ./
COPY alembic.ini ./
COPY migrations ./migrations
COPY apps ./apps
COPY services ./services

RUN pip install --no-cache-dir -r requirements-live.txt \
    && groupadd --system proto \
    && useradd --system --gid proto --home-dir /nonexistent --shell /usr/sbin/nologin proto \
    && chown -R proto:proto /app

USER proto:proto

EXPOSE 8000

CMD ["uvicorn", "apps.api.app.live_app:app", "--host", "0.0.0.0", "--port", "8000"]
