APP_ENV=development
SYSTEM_MODE=LIVE_MONITORING
LIVE_MONITORING_AUTOSTART=false
# Anonymous public market-data venue only: COINBASE or BINANCE.
LIVE_MARKET_SOURCE=COINBASE
LIVE_HISTORY_RETENTION_SECONDS=86400
LIVE_HISTORY_QUERY_MAX=1000
LIVE_HISTORY_PRUNE_EVERY_WRITES=1000
LIVE_DATABASE_AUTO_CREATE=true
POSTGRES_DB=prediction_quant
POSTGRES_USER=prediction
POSTGRES_PASSWORD=prediction
DATABASE_URL=postgresql+asyncpg://prediction:prediction@postgres:5432/prediction_quant
PERSISTENCE_ENABLED=false
ORCHESTRATION_PERSISTENCE_ENABLED=false
REDIS_URL=redis://redis:6379/0
EVENT_BUS_BACKEND=memory
# Optional read-only equity universe allowlists. Catalog presence does not imply live coverage.
ALPACA_EQUITY_SYMBOLS=
BRAPI_EQUITY_SYMBOLS=
# Configure only in the deployment secret store. Never commit the real value.
CREATION_BRIDGE_SHARED_SECRET=
HTTP_RATE_LIMIT_PER_MINUTE=600
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
RUST_LOG=info
MINIMUM_NET_EDGE=0.01
MINIMUM_CONFIDENCE=0.55
MAX_POSITION=10
MAX_NOTIONAL=100000
MAX_DAILY_DRAWDOWN=5000
GRAFANA_ADMIN_PASSWORD=change-me-local-only
