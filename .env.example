APP_ENV=development
SYSTEM_MODE=LIVE_MONITORING
LIVE_MONITORING_AUTOSTART=false
# Anonymous public market-data venue only: COINBASE or BINANCE.
LIVE_MARKET_SOURCE=COINBASE
LIVE_HISTORY_RETENTION_SECONDS=86400
LIVE_HISTORY_QUERY_MAX=1000
LIVE_HISTORY_PRUNE_EVERY_WRITES=1000
LIVE_DATABASE_AUTO_CREATE=true
DATABASE_URL=postgresql+asyncpg://prediction:prediction@postgres:5432/prediction_quant
PERSISTENCE_ENABLED=false
ORCHESTRATION_PERSISTENCE_ENABLED=false
REDIS_URL=redis://redis:6379/0
EVENT_BUS_BACKEND=memory
# Optional read-only equity universe allowlists. Catalog presence does not imply live coverage.
ALPACA_EQUITY_SYMBOLS=
BRAPI_EQUITY_SYMBOLS=
# Configure only in the deployment secret store. Never commit real values.
# Production requires at least 32 characters for both values when configured/used.
CREATION_BRIDGE_SHARED_SECRET=
OPERATOR_API_TOKEN=
# TradingView webhook (docs/tradingview/alerts.md). Unset secret keeps the endpoint closed.
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_INSTRUMENTS=BINANCE_SPOT:BTCBRL,BINANCE_SPOT:ETHBRL,BINANCE_SPOT:SOLBRL
TRADINGVIEW_IP_ALLOWLIST_ENABLED=true
# true only when a reverse proxy you control appends the client address to X-Forwarded-For.
TRADINGVIEW_TRUST_FORWARDED_FOR=false
TRADINGVIEW_MAX_ALERT_AGE_SECONDS=30
# Hybrid agent pipeline (docs/agents/hybrid-pipeline.md). Paper proposals only.
AGENT_PIPELINE_ENABLED=false
# deterministic | claude. Use claude only after the offline reviewer gate passes.
AGENT_REVIEWER=deterministic
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low
AGENT_TIMEOUT_SECONDS=15
AGENT_STOP_DISTANCE=0.02
# Needed only with AGENT_REVIEWER=claude. Keep it in the secret store; it is never sent to venues.
ANTHROPIC_API_KEY=
# Risk Engine (docs/risk/risk-engine.md). Unset key -> ephemeral per-process key.
# Production requires >= 32 characters when set. Keep it only in the secret store.
RISK_PERMIT_SIGNING_KEY=
RISK_PERMIT_TTL_SECONDS=10
RISK_STOP_DISTANCE=0.02
RISK_PRICE_COLLAR_BPS=50
RISK_MAX_QUOTE_AGE_SECONDS=10
# Public HTTPS origin of the deployed dashboard (Oracle Cloud host). Allows its WebSocket origin.
PUBLIC_ORIGIN=
HTTP_RATE_LIMIT_PER_MINUTE=600
VITE_API_BASE_URL=http://localhost:8000
MINIMUM_NET_EDGE=0.01
MINIMUM_CONFIDENCE=0.55
# Paper risk caps: max units per asset position and max simultaneously open positions.
MAX_POSITION=10
SIMULATION_MAX_OPEN_POSITIONS=10
MAX_NOTIONAL=100000
MAX_DAILY_DRAWDOWN=5000
GRAFANA_ADMIN_PASSWORD=change-me-local-only
