APP_ENV=development
SYSTEM_MODE=LIVE_DATA_READ_ONLY
LIVE_DATA_SOURCE=binance
LIVE_DATA_SYMBOL=BTCUSDT
LIVE_DATA_STALE_AFTER_SECONDS=10
LIVE_DATA_CONNECT_TIMEOUT_SECONDS=10
LIVE_DATA_MAX_BACKOFF_SECONDS=30
POSTGRES_DB=prediction_quant
POSTGRES_USER=prediction
POSTGRES_PASSWORD=prediction
DATABASE_URL=postgresql+asyncpg://prediction:prediction@postgres:5432/prediction_quant
PERSISTENCE_ENABLED=false
REDIS_URL=redis://redis:6379/0
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
RUST_LOG=info
MINIMUM_NET_EDGE=0.01
MINIMUM_CONFIDENCE=0.55
MAX_POSITION=10
MAX_NOTIONAL=100000
MAX_DAILY_DRAWDOWN=5000
